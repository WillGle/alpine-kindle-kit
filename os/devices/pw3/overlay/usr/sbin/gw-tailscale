#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# On-demand Tailscale userspace daemon for the PW3.
#
#   gw-tailscale on       start tailscaled + loopback SOCKS5
#   gw-tailscale off      stop it
#   gw-tailscale status   print the PID or nothing
#
# The daemon is not started at boot.  The Hub screen starts it when it opens
# and stops it when it closes.  Every call is serialised and validates the PID
# against /proc before signalling it, so a stale pidfile can never kill an
# unrelated process and two callers cannot start two daemons.
set -eu

pidfile=/run/tailscaled.pid
log=/run/tailscaled.log
lockdir=/run/tailscaled.lock
socks=127.0.0.1:1055
binary=/usr/sbin/tailscaled
socks_port=041F   # 1055 in /proc/net/tcp

is_tailscaled() {
    pid=$1
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -r "/proc/$pid/comm" ] || return 1
    [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "tailscaled" ]
}

find_pid() {
    if [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile" 2>/dev/null || true)
        if is_tailscaled "$pid"; then printf '%s\n' "$pid"; return 0; fi
        rm -f "$pidfile"
    fi
    for pid in $(pidof tailscaled 2>/dev/null || true); do
        if is_tailscaled "$pid"; then printf '%s\n' "$pid"; return 0; fi
    done
    return 1
}

take_lock() {
    tries=0
    while ! mkdir "$lockdir" 2>/dev/null; do
        tries=$((tries + 1))
        if [ "$tries" -ge 200 ]; then
            # A killed caller can leave the directory behind.  Wait well past
            # the longest normal start (readiness wait) before stealing it.
            rm -rf "$lockdir"
            mkdir "$lockdir" 2>/dev/null && break
            echo "gw-tailscale: another call is still running" >&2
            return 1
        fi
        sleep 0.1
    done
    trap 'rmdir "$lockdir" 2>/dev/null || true' EXIT INT TERM
}

socks_ready() {
    [ -r /proc/net/tcp ] || return 0
    grep -q " 0100007F:$socks_port " /proc/net/tcp
}

# The PW3 image does not run Alpine's networking service, so loopback can be
# DOWN with no 127.0.0.1 address.  tailscaled's SOCKS listener then fails with
# EADDRNOTAVAIL and exits.  Bring it up on demand; both calls are idempotent.
ensure_loopback() {
    if [ -x /sbin/ip ]; then
        /sbin/ip link set lo up 2>/dev/null || true
        /sbin/ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true
    else
        ifconfig lo up 2>/dev/null || true
        ifconfig lo 127.0.0.1 netmask 255.0.0.0 up 2>/dev/null || true
    fi
}

stop_all() {
    found=0
    if [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile" 2>/dev/null || true)
        if is_tailscaled "$pid"; then
            kill "$pid" 2>/dev/null || true
            found=1
        fi
        rm -f "$pidfile"
    fi
    for pid in $(pidof tailscaled 2>/dev/null || true); do
        if is_tailscaled "$pid"; then
            kill "$pid" 2>/dev/null || true
            found=1
        fi
    done
    [ "$found" = 1 ] || return 0
    i=0
    while [ "$i" -lt 50 ]; do
        alive=0
        for pid in $(pidof tailscaled 2>/dev/null || true); do
            if is_tailscaled "$pid"; then alive=1; fi
        done
        [ "$alive" = 0 ] && return 0
        i=$((i + 1))
        sleep 0.1
    done
    for pid in $(pidof tailscaled 2>/dev/null || true); do
        if is_tailscaled "$pid"; then kill -9 "$pid" 2>/dev/null || true; fi
    done
    return 0
}

case "${1:-status}" in
on)
    take_lock
    if pid=$(find_pid); then
        echo "tailscaled already running: $pid"
        exit 0
    fi
    if ! [ -x "$binary" ]; then
        echo "tailscaled not installed" >&2
        exit 1
    fi
    ensure_loopback
    mkdir -p /var/run/tailscale /var/lib/tailscale
    : > "$log"
    # --tun=userspace-networking is mandatory: the PW3 kernel has no TUN.
    # Exit-node advertisement is opt-in so a normal client stays a normal
    # client; create /etc/gleworks/tailscale-exit-node to enable it.
    set -- --tun=userspace-networking --socks5-server="$socks" --statedir=/var/lib/tailscale
    if [ -e /etc/gleworks/tailscale-exit-node ]; then
        # Exit-node forwarding.  Userspace networking does the forwarding
        # itself, but the kernel sysctls keep routed client traffic working.
        echo 1 > /proc/sys/net/ipv4/ip_forward 2>/dev/null || true
        echo 1 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || true
        set -- "$@" --advertise-exit-node
    fi
    nohup "$binary" "$@" >>"$log" 2>&1 &
    # tailscaled daemonises on this build, so $! is not the long-lived PID.
    # Discover the real process instead of trusting the parent.
    i=0
    pid=""
    while [ "$i" -lt 50 ]; do
        pid=$(pidof tailscaled 2>/dev/null | awk '{print $1}')
        if [ -n "$pid" ] && is_tailscaled "$pid"; then
            if socks_ready; then break; fi
        fi
        i=$((i + 1))
        sleep 0.1
    done
    if [ -z "$pid" ] || ! is_tailscaled "$pid"; then
        echo "tailscaled did not start; see $log" >&2
        tail -5 "$log" >&2 2>/dev/null || true
        rm -f "$pidfile"
        exit 1
    fi
    echo "$pid" >"$pidfile"
    echo "tailscaled started: $pid socks=$socks"
    ;;
off)
    take_lock
    stop_all
    echo "tailscaled stopped"
    ;;
exit-node)
    take_lock
    case "${2:-status}" in
    on)
        mkdir -p /etc/gleworks
        : > /etc/gleworks/tailscale-exit-node
        if find_pid >/dev/null; then stop_all; fi
        echo "exit-node advertisement enabled; it applies on the next start"
        ;;
    off)
        rm -f /etc/gleworks/tailscale-exit-node
        if find_pid >/dev/null; then stop_all; fi
        echo "exit-node advertisement disabled"
        ;;
    status)
        if [ -e /etc/gleworks/tailscale-exit-node ]; then
            echo "exit-node flag: on"
        else
            echo "exit-node flag: off"
        fi
        ;;
    *)
        echo "usage: gw-tailscale exit-node on|off|status" >&2
        exit 2
        ;;
    esac
    ;;
status)
    find_pid || true
    ;;
*)
    echo "usage: gw-tailscale on|off|status|exit-node on|off|status" >&2
    exit 2
    ;;
esac
