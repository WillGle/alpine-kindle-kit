# PW3 scroll policy for the GleWorks service.
#
# Six live preview frames per drag keep scrolling responsive.  Automatic
# After scrolling, clean only the touched area with a partial GC16.  This
# removes residue without the whole-panel black/white flash of a full update.
# Lock/unlock remains the explicit full clean.
# Fallback values; the paint-profile engine applies the per-screen value.
export GW_UI_SCROLL_PREVIEW_MAX=2
export GW_UI_SCROLL_PREVIEW_MS=160
export GW_UI_SCROLL_CLEAN_MS=800
export GW_UI_SCROLL_CLEAN_MIN_MS=3000
# 0 = profile default (off). Set e.g. 30 to force a full clean after N updates.
export GW_UI_FULL_REFRESH_AFTER=0
