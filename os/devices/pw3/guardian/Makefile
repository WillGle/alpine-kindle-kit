obj-m := gleworks_pid1_reset.o

# reset-token.h is a per-build secret generated by tools/build/pw3-build.py.
# Refuse to build a module from a missing or stale tree instead of silently
# pairing it with an unrelated identity.
gleworks_pid1_reset.o: reset-token.h

reset-token.h:
	@echo "ERROR: reset-token.h is missing; generate a paired build with tools/build/pw3-build.py" >&2
	@false
