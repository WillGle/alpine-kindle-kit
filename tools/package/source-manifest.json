{
  "comment": "Public-source dependency manifest. Every path the builder consumes must be listed here; public-source.py refuses to guess from a hand-maintained suffix list.",
  "roots": {
    "os/alpine": ["**/*"],
    "os/devices/pw3": ["**/*"],
    "os/system": ["**/*"],
    "os/ui": ["**/*"],
    "apps/koreader": ["**/*"],
    "theme": ["**/*"],
    "tools/build": ["**/*"],
    "tools/install": ["**/*"],
    "tools/lib": ["**/*"],
    "tools/maintenance": ["**/*"],
    "tools/package": ["**/*"],
    "tools/tests": ["**/*"],
    "vm": ["**/*"]
  },
  "docs": [
    ".gitignore",
    "LICENSE",
    "docs/README.md",
    "docs/community/README.md",
    "docs/community/BUILD.md",
    "docs/community/CONTRIBUTING.md",
    "docs/community/LICENSES.md",
    "docs/community/STATUS.json",
    "docs/community/licenses/GPL-3.0.txt",
    "docs/community/licenses/Linux-COPYING.txt",
    "docs/guides/STRUCTURE.md",
    "docs/technical/README.md",
    "docs/technical/PAINT-PROFILE-ENGINE.md"
  ],
  "exclude": [
    "**/__pycache__/**",
    "**/*.pyc",
    "os/system/gw-system",
    "os/system/gwctl",
    "os/system/gw-appctl",
    "os/system/gw-data-mount",
    "os/system/test-stage3",
    "os/system/test-power-policy",
    "os/system/test-power-io",
    "os/system/test-apps",
    "os/system/test-apps-install",
    "os/ui/gw-shell",
    "os/ui/gw-shell-debug",
    "os/ui/host-sim",
    "os/ui/sim/*.png",
    "os/ui/sim/*.ppm",
    "os/system/tests/test-sandbox/**",
    "os/devices/pw3/guardian/reset-token.h"
  ],
  "required": [
    "os/devices/pw3/overlay/etc/conf.d/gw-system",
    "apps/koreader/overlay/etc/gleworks-managed-reader.sh",
    "apps/koreader/overlay/opt/koreader/plugins/gw-home.koplugin/main.lua",
    "apps/koreader/overlay/opt/koreader/plugins/gw-theme.koplugin/main.lua",
    "apps/koreader/source.json",
    "os/system/gw-system.c",
    "os/system/gw-apps.c",
    "os/system/gw-signature.c",
    "os/system/Makefile",
    "os/system/app-keys/release.pem",
    "os/ui/gw-shell.c",
    "os/ui/Makefile",
    "theme/tokens.json",
    "theme/generate.py",
    "tools/build/pw3-build.py",
    "tools/build/gwapp.py",
    "tools/lib/pw3_common.py",
    "tools/package/public-source.py",
    "tools/package/verify-package.py",
    "tools/tests/test_hardening.py"
  ]
}
