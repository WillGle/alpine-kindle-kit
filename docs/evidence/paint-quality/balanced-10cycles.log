  sleep 0.7
  gwctl ui-nav HOME >/dev/null
  sleep 0.7
  i=$((i+1))
done
sleep 1
echo ---SEGMENT---
tail -n +$((L+1)) /run/gw-system.log | grep -E '"'"'epdc submit|GW_UI_DIAG'"'"'
'); rc=$?; printf '\nGW_DONE_%s:%s\n' 730acc506f0cbd0184523d91 "$rc"
