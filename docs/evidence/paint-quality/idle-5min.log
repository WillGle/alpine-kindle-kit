SHELL
( /bin/busybox sh -c '
printf '"'"'quality
'"'"' > /etc/gleworks/paint-policy
/etc/init.d/gw-system restart >/dev/null 2>&1
sleep 5
L=$(wc -l < /run/gw-system.log)
B=$(wc -c < /run/gw-system.log)
echo START_LINES=$L START_BYTES=$B
sleep 300
L2=$(wc -l < /run/gw-system.log)
B2=$(wc -c < /run/gw-system.log)
echo END_LINES=$L2 END_BYTES=$B2
echo SUBMITS:
tail -n +$((L+1)) /run/gw-system.log | grep -c '"'"'epdc submit'"'"'
echo DIAG:
tail -n +$((L+1)) /run/gw-system.log | grep '"'"'epdc submit'"'"' || true
'); rc=$?; printf '\nGW_DONE_%s:%s\n' 846c9c8bf3d705ab25420dae "$rc"
