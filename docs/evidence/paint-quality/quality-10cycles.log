SHELL
( /bin/busybox sh -c '
printf '"'"'quality
'"'"' > /etc/gleworks/paint-policy
/etc/init.d/gw-system restart >/dev/null 2>&1
sleep 4
L=$(wc -l < /run/gw-system.log)
i=0
while [ $i -lt 10 ]; do
  gwctl ui-nav SETTINGS >/dev/null
  sleep 0.7
  gwctl ui-nav HOME >/dev/null
  sleep 0.7
  i=$((i+1))
done
sleep 1
echo ---SEGMENT---
tail -n +$((L+1)) /run/gw-system.log | grep -E '"'"'epdc submit|GW_UI_DIAG'"'"' 
'); rc=$?; printf '\nGW_DONE_%s:%s\n' ec9fae38adc3657379ad61b5 "$rc"
